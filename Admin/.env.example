# Backend Server Base URL (Used for API proxy config and directly resolving backend URLs)
VITE_SERVER_URL=http://localhost:5000

# Client App URL (Used for cross-app linking/referrals)
VITE_CLIENT_URL=http://localhost:5173

# API base path (Vite proxy redirects this to backend target)
VITE_API_BASE_URL=/api

# GST Billing & Seller Details
VITE_GST_COMPANY_NAME=Billu Bazaar Private Limited
VITE_GSTIN=33ABCDE1234F1Z5
VITE_GST_PAN=ABCDE1234F
VITE_GST_STATE=Tamil Nadu
VITE_GST_STATE_CODE=33
VITE_GST_ADDRESS=Door No. 12/A, Luxury Commercial Avenue, Anna Salai, Chennai, Tamil Nadu - 600002
VITE_GST_EMAIL=support@billubazaar.com
VITE_GST_PHONE=+91 91638 24881
VITE_GST_WEBSITE=www.billubazaar.com

# Optional JSON format override:
# VITE_GST_BILLING={"companyName":"Billu Bazaar Private Limited","gstin":"33ABCDE1234F1Z5","pan":"ABCDE1234F","state":"Tamil Nadu","stateCode":"33","address":"Door No. 12/A, Luxury Commercial Avenue, Chennai, Tamil Nadu - 600002","email":"support@billubazaar.com","phone":"+91 91638 24881","website":"www.billubazaar.com"}

