PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=billu_bazaar
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
API_URL=http://localhost:5000

# Admin Email for Notifications
ADMIN_EMAIL=harish05082004@gmail.com

# Razorpay Gateway Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Telr Gateway Configuration (AED Payments)
# TELR_SECRET_KEY is used to verify the SHA1 tran_check webhook signature (falls back to TELR_AUTH_KEY if unset)
TELR_STORE_ID=mock_store_id
TELR_AUTH_KEY=mock_auth_key
TELR_SECRET_KEY=mock_secret_key
TELR_TEST_MODE=1

# Gmail SMTP
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
